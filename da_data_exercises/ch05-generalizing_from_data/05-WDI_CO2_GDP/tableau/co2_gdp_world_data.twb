      <column caption='k.GDP Ppp | Median' datatype='real' name='[Calculation_1833190471593989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED: MEDIAN([GDP_PPP])}' />
      </column>
      <column caption='k.Gdp Ppp | diff vs Median' datatype='real' name='[Calculation_1833190472278022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GDP_PPP]) - SUM([Calculation_1833190471593989])' />
      </column>
      <column caption='CO2 Capita | Avg (LOD)' datatype='real' name='[Calculation_1833190474268680]' role='measure' type='quantitative'>
