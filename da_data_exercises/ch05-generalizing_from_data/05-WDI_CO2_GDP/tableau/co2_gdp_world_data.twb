      <table>
        <view>
          <datasources>
            <datasource caption='bootstrap_simulation' name='federated.1jij0ac1xy3ro611wo3zt0s6tzco' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p.bin size' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='0.25'>
              <calculation class='tableau' formula='0.25' />
              <range granularity='0.25' max='1.0' min='0.25' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1jij0ac1xy3ro611wo3zt0s6tzco'>
            <column caption='CI | Upper' datatype='real' name='[CI | Lower (copy)_2574807454986247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='PERCENTILE([CO2_Gap_Difference], 0.975)' />
            </column>
            <column caption='CO2 Gap Difference' datatype='real' name='[CO2_Gap_Difference]' role='measure' type='quantitative' />
            <column caption='02.CO2 Gap Diff Bin (calc)' datatype='real' name='[Calculation_1363420447965190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT([Calculation_1363420448571399]/[Parameters].[Parameter 1])*[Parameters].[Parameter 1]&#13;&#10;-&#13;&#10;IIF([Calculation_1363420448571399] &lt; 0, [Parameters].[Parameter 1],0)' />
            </column>
            <column caption='01.CO2 Gap Difference (LOD)' datatype='real' name='[Calculation_1363420448571399]' role='measure' type='quantitative'>
