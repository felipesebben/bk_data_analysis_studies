              <zone fixed-size='379' forceUpdate='true' h='1217' id='65' is-fixed='true' type-v2='text' w='37900' x='57200' y='51339'>
                <formatted-text>
                  <run fontcolor='#546e7a'>CO2 Per Capita Emissions, Tons (t)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='0' />
                </zone-style>
              </zone>
            </zone>
            <zone-style>
