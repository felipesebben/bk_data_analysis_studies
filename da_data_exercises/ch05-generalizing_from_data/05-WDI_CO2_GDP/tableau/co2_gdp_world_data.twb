    <worksheet name='Jitter | Distribution | CO2 Per Capita '>
      <table>
        <view>
          <datasources>
            <datasource caption='co_gdp_countries' name='federated.1t93j9q0b4m3xb19t8p2x0xmqin9' />
          </datasources>
          <datasource-dependencies datasource='federated.1t93j9q0b4m3xb19t8p2x0xmqin9'>
            <column caption='CO2 | HI | Avg' datatype='real' name='[CO2 | LI | Avg (copy)_1363420442525697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(CASE [Income_Group] = &quot;Higher Income&quot;&#13;&#10;    WHEN TRUE THEN [CO2_Capita]&#13;&#10;END)' />
            </column>
            <column caption='CO2 Capita' datatype='real' name='[CO2_Capita]' role='measure' type='quantitative' />
            <column caption='SUM([CO2 Capita])/1' datatype='real' name='[Calculation_1059133071622146]' role='measure' type='quantitative' user:unnamed='Jitter | Distribution | CO2 Per Capita '>
              <calculation class='tableau' formula='SUM([CO2_Capita])/1' />
            </column>
            <column caption='CO2 | LI | Avg' datatype='real' name='[Calculation_1363420441051136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(CASE [Income_Group] = &quot;Lower Income&quot;&#13;&#10;    WHEN TRUE THEN [CO2_Capita]&#13;&#10;END)' />
            </column>
            <column caption='k.GDP Ppp | Median' datatype='real' name='[Calculation_1833190471593989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED: MEDIAN([GDP_PPP])}' />
            </column>
            <column caption='k.Gdp Ppp | diff vs Median' datatype='real' name='[Calculation_1833190472278022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GDP_PPP]) - SUM([Calculation_1833190471593989])' />
            </column>
            <column caption='CO2 Capita | Avg (LOD)' datatype='real' name='[Calculation_1833190474268680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Income_Group]: AVG([CO2_Capita])}' />
            </column>
            <column caption='k.CO2 Capita | Diff vs Avg (LOD Group)' datatype='real' name='[Calculation_1833190475612172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([CO2_Capita]) - AVG([Calculation_1833190474268680])' />
            </column>
            <column caption='s.CO2 Capita | Diff vs Avg (LOD) | comparison' datatype='string' name='[Calculation_1833190475984909]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_1833190475612172] &gt;= 0&#13;&#10;    WHEN TRUE THEN &quot;more&quot;&#13;&#10;    WHEN FALSE THEN &quot;less&quot;&#13;&#10;END' />
            </column>
            <column caption='v.label higher income' datatype='real' name='[Calculation_1892287379238916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Income_Group] = &quot;Higher Income&quot; THEN 1.5&#13;&#10;END' />
            </column>
            <column caption='random()' datatype='real' name='[Calculation_2408230405042177]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='random()' />
            </column>
            <column caption='CO2 | Difference' datatype='real' name='[Calculation_2408230411784200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM(&#13;&#10;    CASE [Income_Group] = &quot;Higher Income&quot;&#13;&#10;        WHEN TRUE THEN&#13;&#10;            ([CO2_Capita])&#13;&#10;    END&#13;&#10;    ))&#13;&#10;-&#13;&#10;WINDOW_AVG(SUM(&#13;&#10;    CASE [Income_Group] = &quot;Lower Income&quot;&#13;&#10;        WHEN TRUE THEN&#13;&#10;            ([CO2_Capita])&#13;&#10;    END&#13;&#10;    ))'>
